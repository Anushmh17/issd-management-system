# ISSD Management - Security Protection
# Prevent directory listing
Options -Indexes

# Protect sensitive files
<FilesMatch "^\.env|config\.php|db\.php|.*\.log|.*\.sql$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

